# Copy to .env and adjust. `.env` is git-ignored (STANDARDS §1.5).
# The local Postgres credentials below are the documented non-secret throwaway
# values from docker-compose.yml (CL-E21). Never put real credentials in this file.

# Environment the API runs in: development | test | production
NODE_ENV=development

# Port the Fastify API listens on.
PORT=3000

# Host interface the Fastify API binds to.
HOST=127.0.0.1

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string for development. Required; the API refuses to start without it.
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard

# PostgreSQL connection string used by the integration test project only.
DATABASE_URL_TEST=postgres://flowboard:flowboard@localhost:5432/flowboard_test

# The single browser origin allowed to send a cookie-authenticated mutation
# (CL-E9). Distinct from CORS_ORIGIN, which may list several read origins.
WEB_ORIGIN=http://localhost:5173

# Force the `Secure` attribute on the fb_session cookie: true | false.
# Leave unset to derive it from NODE_ENV (off only in development).
# SESSION_COOKIE_SECURE=true

# Tests only. Turns off the authentication rate limits (CL-E11) so one test
# file's fixtures cannot throttle the next. Never set this in production.
RATE_LIMIT_DISABLED=false
