{
  "name": "@flowboard/api",
  "version": "0.1.0",
  "private": true,
  "description": "FlowBoard Fastify service: REST API at /v1, Drizzle schema and migrations.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "start": "node dist/src/server.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts up",
    "db:migrate:down": "tsx src/db/migrate.ts down --all",
    "db:seed": "tsx src/db/seed/run.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.9.1",
    "@flowboard/shared": "workspace:*",
    "argon2": "0.44.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "uuidv7": "1.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
